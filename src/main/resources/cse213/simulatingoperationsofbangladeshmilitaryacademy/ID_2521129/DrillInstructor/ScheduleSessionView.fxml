<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="cse213.simulatingoperationsofbangladeshmilitaryacademy.ID_2521129.DrillInstructor.Controller.ScheduleSessionController"
            prefHeight="520.0" prefWidth="640.0">
    <children>
        <Label layoutX="21.0" layoutY="14.0" text="Schedule Training Session">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        <Label layoutX="40.0" layoutY="70.0" text="Platoon:" />
        <ComboBox fx:id="platoonCB" layoutX="150.0" layoutY="66.0" prefWidth="160.0" />
        <Label layoutX="340.0" layoutY="70.0" text="Date:" />
        <DatePicker fx:id="sessionDP" layoutX="445.0" layoutY="66.0" prefWidth="160.0" />
        <Label layoutX="40.0" layoutY="115.0" text="Time:" />
        <TextField fx:id="timeTF" layoutX="150.0" layoutY="111.0" prefHeight="26.0" prefWidth="160.0" promptText="e.g. 06:00" />
        <Label layoutX="340.0" layoutY="115.0" text="Activity Type:" />
        <ComboBox fx:id="activityTypeCB" layoutX="445.0" layoutY="111.0" prefWidth="160.0" />
        <Label layoutX="40.0" layoutY="160.0" text="Location:" />
        <TextField fx:id="locationTF" layoutX="150.0" layoutY="156.0" prefHeight="26.0" prefWidth="455.0" />
        <Button layoutX="240.0" layoutY="210.0" mnemonicParsing="false" onAction="#publishButtonOnAction" text="Confirm &amp; Publish" />
        <Label layoutX="40.0" layoutY="260.0" text="Scheduled Sessions:" />
        <TableView fx:id="sessionTV" layoutX="40.0" layoutY="285.0" prefHeight="200.0" prefWidth="565.0">
            <columns>
                <TableColumn fx:id="platoonCol" prefWidth="100.0" text="Platoon" />
                <TableColumn fx:id="dateCol" prefWidth="120.0" text="Date" />
                <TableColumn fx:id="timeCol" prefWidth="90.0" text="Time" />
                <TableColumn fx:id="activityCol" prefWidth="130.0" text="Activity" />
                <TableColumn fx:id="locationCol" prefWidth="125.0" text="Location" />
            </columns>
        </TableView>
    </children>
</AnchorPane>