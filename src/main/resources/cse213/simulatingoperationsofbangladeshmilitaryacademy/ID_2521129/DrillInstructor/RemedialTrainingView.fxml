        <TextField fx:id="durationTF" layoutX="450.0" layoutY="356.0" prefHeight="26.0" prefWidth="155.0" />
        <Button layoutX="230.0" layoutY="415.0" mnemonicParsing="false" onAction="#assignButtonOnAction" text="Assign Remedial Training" />
      <Button layoutX="25.0" layoutY="459.0" mnemonicParsing="false" onAction="#backButtonOnAction" prefHeight="26.0" prefWidth="126.0" text="Back" />
    </children>
</AnchorPane>
