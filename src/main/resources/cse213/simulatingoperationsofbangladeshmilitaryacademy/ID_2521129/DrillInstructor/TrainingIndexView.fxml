<AnchorPane prefHeight="500.0" prefWidth="640.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cse213.simulatingoperationsofbangladeshmilitaryacademy.ID_2521129.DrillInstructor.Controller.TrainingIndexController">
    <children>
        <Label layoutX="21.0" layoutY="14.0" text="Military Training Index">
