<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #edf2ee;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cse213.simulatingoperationsofbangladeshmilitaryacademy.ataulislam.Cadet.ManagePTIAndDirectingStaffAssignmentsController">

    <BorderPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <!-- CENTER CONTENT -->
        <center>
            <VBox spacing="15" style="-fx-padding: 22;">

                <Label style="-fx-font-size: 20px;                               -fx-font-weight: bold;                               -fx-text-fill: #123c2a;" text="MANAGE PTI AND DIRECTING STAFF ASSIGNMENTS" />

                <Label style="-fx-font-size: 13px;                               -fx-text-fill: #555555;" text="Select staff and assign training responsibilities." />

                <!-- ASSIGNMENT FORM -->
                <VBox spacing="12" style="-fx-background-color: white;                              -fx-padding: 20;                              -fx-background-radius: 10;                              -fx-border-color: #cbd8ce;                              -fx-border-radius: 10;">

                    <Label style="-fx-font-size: 17px;                                   -fx-font-weight: bold;                                   -fx-text-fill: #123c2a;" text="Staff Assignment Information" />

                    <Separator />

                    <HBox spacing="18">

                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Select Company / Training Unit" />

                            <ComboBox fx:id="companyComboBox" maxWidth="Infinity" promptText="Select Company / Unit" />
                        </VBox>

                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Staff Type" />

                            <ComboBox fx:id="staffTypeComboBox" maxWidth="Infinity" promptText="Select Staff Type" />
                        </VBox>

                    </HBox>

                    <HBox spacing="18">

                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Select PTI / Directing Staff" />

                            <ComboBox fx:id="staffComboBox" maxWidth="Infinity" promptText="Select Staff Member" />
                        </VBox>

                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Training Responsibility" />

                            <ComboBox fx:id="responsibilityComboBox" maxWidth="Infinity" promptText="Select Responsibility" />
                        </VBox>

                    </HBox>

                    <!-- STAFF PROFILE -->
                    <VBox spacing="7" style="-fx-background-color: #edf5ef;                                  -fx-padding: 12;                                  -fx-background-radius: 6;">

                        <Label style="-fx-font-size: 15px;                                       -fx-font-weight: bold;                                       -fx-text-fill: #123c2a;" text="Selected Staff Profile" />

                        <HBox spacing="25">
                            <Label fx:id="staffNameLabel" text="Staff Name: Not Selected" />

                            <Label fx:id="staffRoleLabel" text="Staff Role: Not Selected" />
                        </HBox>

                        <Label fx:id="staffUnitLabel" text="Company / Unit: Not Selected" />

                    </VBox>

                    <HBox spacing="18">

                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Training Activity" />

                            <ComboBox fx:id="activityComboBox" maxWidth="Infinity" promptText="Select Training Activity" />
                        </VBox>

                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Workload (Hours)" />

                            <TextField fx:id="workloadField" promptText="Enter workload hours" />
                        </VBox>

                    </HBox>

                    <Separator />

                    <!-- BUTTONS -->
                    <HBox alignment="CENTER" spacing="15">

                        <Button onAction="#handleAssignStaff" style="-fx-background-color: #123c2a;                                        -fx-text-fill: white;                                        -fx-font-weight: bold;                                        -fx-padding: 11 30;                                        -fx-background-radius: 5;" text="Assign Staff" />

                        <Button onAction="#handleClear" style="-fx-background-color: #777777;                                        -fx-text-fill: white;                                        -fx-font-weight: bold;                                        -fx-padding: 11 30;                                        -fx-background-radius: 5;" text="Clear" />

                    </HBox>

                    <Label fx:id="statusLabel" style="-fx-font-size: 13px;" text="" wrapText="true" />

                </VBox>

                <!-- ASSIGNMENT TABLE -->
                <VBox spacing="10" style="-fx-background-color: white;                              -fx-padding: 15;                              -fx-background-radius: 10;                              -fx-border-color: #cbd8ce;                              -fx-border-radius: 10;">

                    <Label style="-fx-font-size: 17px;                                   -fx-font-weight: bold;                                   -fx-text-fill: #123c2a;" text="Assigned PTI and Directing Staff Records" />

                    <TableView fx:id="assignmentTable" prefHeight="180">

                        <columns>

                            <TableColumn fx:id="staffIdColumn" prefWidth="100" text="Staff ID" />

                            <TableColumn fx:id="staffTableNameColumn" prefWidth="150" text="Staff Name" />

                            <TableColumn fx:id="staffTableRoleColumn" prefWidth="140" text="Staff Type" />

                            <TableColumn fx:id="unitColumn" prefWidth="150" text="Company / Unit" />

                            <TableColumn fx:id="responsibilityColumn" prefWidth="170" text="Responsibility" />

                            <TableColumn fx:id="activityColumn" prefWidth="150" text="Training Activity" />

                            <TableColumn fx:id="workloadColumn" prefWidth="120" text="Workload (Hours)" />

                        </columns>

                    </TableView>

                </VBox>

            </VBox>
        </center>

        <!-- FOOTER -->
        <bottom>
            <HBox alignment="CENTER" prefHeight="40" style="-fx-background-color: #123c2a;">

                <Label style="-fx-text-fill: white;                               -fx-font-size: 11px;" text="Bangladesh Military Academy | Cadet Management System" />

            </HBox>
        </bottom>

    </BorderPane>

</AnchorPane>
