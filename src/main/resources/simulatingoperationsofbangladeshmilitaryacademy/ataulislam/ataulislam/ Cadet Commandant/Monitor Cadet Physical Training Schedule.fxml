<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #edf2ee;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cse213.simulatingoperationsofbangladeshmilitaryacademy.ataulislam.Cadet.MonitorCadetPhysicalTrainingScheduleController">

    <BorderPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <!-- CENTER CONTENT -->
        <center>
            <VBox spacing="16" style="-fx-padding: 25;">

                <Label style="-fx-font-size: 20px;                               -fx-font-weight: bold;                               -fx-text-fill: #123c2a;" text="MONITOR CADET PHYSICAL TRAINING SCHEDULE" />

                <Label style="-fx-font-size: 13px;                               -fx-text-fill: #555555;" text="Monitor and confirm company-wise and platoon-wise physical training schedules." />

                <!-- SEARCH SECTION -->
                <VBox spacing="14" style="-fx-background-color: white;                              -fx-padding: 20;                              -fx-background-radius: 10;                              -fx-border-color: #cbd8ce;                              -fx-border-radius: 10;">

                    <Label style="-fx-font-size: 17px;                                   -fx-font-weight: bold;                                   -fx-text-fill: #123c2a;" text="Training Schedule Search" />

                    <Separator />

                    <HBox spacing="20">

                        <VBox spacing="7" HBox.hgrow="ALWAYS">

                            <Label text="Select Company" />

                            <ComboBox fx:id="companyComboBox" maxWidth="Infinity" promptText="Select Company" />

                        </VBox>

                        <VBox spacing="7" HBox.hgrow="ALWAYS">

                            <Label text="Select Platoon" />

                            <ComboBox fx:id="platoonComboBox" maxWidth="Infinity" promptText="Select Platoon" />

                        </VBox>

                        <VBox spacing="7" HBox.hgrow="ALWAYS">

                            <Label text="Training Date" />

                            <DatePicker fx:id="trainingDatePicker" maxWidth="Infinity" promptText="Select Training Date" />

                        </VBox>

                    </HBox>

                    <HBox alignment="CENTER" spacing="15">

                        <Button onAction="#handleViewSchedule" style="-fx-background-color: #123c2a;                                        -fx-text-fill: white;                                        -fx-font-weight: bold;                                        -fx-padding: 11 28;                                        -fx-background-radius: 5;" text="View Schedule" />

                        <Button onAction="#handleConfirmSchedule" style="-fx-background-color: #287a46;                                        -fx-text-fill: white;                                        -fx-font-weight: bold;                                        -fx-padding: 11 28;                                        -fx-background-radius: 5;" text="Confirm Schedule" />

                        <Button onAction="#handleClear" style="-fx-background-color: #777777;                                        -fx-text-fill: white;                                        -fx-font-weight: bold;                                        -fx-padding: 11 30;                                        -fx-background-radius: 5;" text="Clear" />

                    </HBox>

                    <Label fx:id="statusLabel" style="-fx-font-size: 13px;" text="" wrapText="true" />

                </VBox>

                <!-- SCHEDULE TABLE -->
                <VBox spacing="12" style="-fx-background-color: white;                              -fx-padding: 18;                              -fx-background-radius: 10;                              -fx-border-color: #cbd8ce;                              -fx-border-radius: 10;">

                    <Label style="-fx-font-size: 17px;                                   -fx-font-weight: bold;                                   -fx-text-fill: #123c2a;" text="Cadet Physical Training Schedule" />

                    <TableView fx:id="scheduleTable" prefHeight="260">

                        <columns>

                            <TableColumn fx:id="scheduleIdColumn" prefWidth="100" text="Schedule ID" />

                            <TableColumn fx:id="activityColumn" prefWidth="180" text="Training Activity" />

                            <TableColumn fx:id="timeColumn" prefWidth="120" text="Training Time" />

                            <TableColumn fx:id="venueColumn" prefWidth="150" text="Training Venue" />

                            <TableColumn fx:id="ptiColumn" prefWidth="150" text="Assigned PTI" />

                            <TableColumn fx:id="durationColumn" prefWidth="100" text="Duration" />

                            <TableColumn fx:id="confirmationColumn" prefWidth="150" text="Confirmation Status" />

                        </columns>

                    </TableView>

                    <Label style="-fx-font-size: 12px;                                   -fx-text-fill: #666666;" text="Select a schedule from the table and click Confirm Schedule to confirm it." wrapText="true" />

                </VBox>

            </VBox>
        </center>

        <!-- FOOTER -->
        <bottom>
            <HBox alignment="CENTER" prefHeight="40" style="-fx-background-color: #123c2a;">

                <Label style="-fx-text-fill: white;                               -fx-font-size: 11px;" text="Bangladesh Military Academy | Cadet Management System" />

            </HBox>
        </bottom>

    </BorderPane>

</AnchorPane>
