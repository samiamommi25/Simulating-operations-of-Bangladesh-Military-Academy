<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #edf2ee;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cse213.simulatingoperationsofbangladeshmilitaryacademy.ataulislam.Cadet.ReviewCadetTrainingAttendanceAndDisciplineController">

    <BorderPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <!-- CENTER CONTENT -->
        <center>
            <VBox spacing="18" style="-fx-padding: 25;">

                <Label style="-fx-font-size: 20px;                               -fx-font-weight: bold;                               -fx-text-fill: #123c2a;" text="REVIEW CADET TRAINING ATTENDANCE AND DISCIPLINE" />

                <Label style="-fx-font-size: 13px;                               -fx-text-fill: #555555;" text="Select company, platoon and reporting date to review cadet records." />

                <!-- SEARCH SECTION -->
                <VBox spacing="15" style="-fx-background-color: white;                              -fx-padding: 20;                              -fx-background-radius: 10;                              -fx-border-color: #cbd8ce;                              -fx-border-radius: 10;">

                    <Label style="-fx-font-size: 17px;                                   -fx-font-weight: bold;                                   -fx-text-fill: #123c2a;" text="Search Attendance and Discipline Records" />

                    <Separator />

                    <HBox spacing="20">

                        <VBox spacing="7" HBox.hgrow="ALWAYS">
                            <Label text="Select Company" />

                            <ComboBox fx:id="companyComboBox" maxWidth="Infinity" promptText="Select Company" />
                        </VBox>

                        <VBox spacing="7" HBox.hgrow="ALWAYS">
                            <Label text="Select Platoon" />

                            <ComboBox fx:id="platoonComboBox" maxWidth="Infinity" promptText="Select Platoon" />
                        </VBox>

                        <VBox spacing="7" HBox.hgrow="ALWAYS">
                            <Label text="Reporting Date" />

                            <DatePicker fx:id="reportingDatePicker" maxWidth="Infinity" promptText="Select Date" />
                        </VBox>

                    </HBox>

                    <HBox alignment="CENTER" spacing="12">

                        <Button onAction="#handleViewAttendance" style="-fx-background-color: #123c2a;                                        -fx-text-fill: white;                                        -fx-font-weight: bold;                                        -fx-padding: 10 25;                                        -fx-background-radius: 5;" text="View Attendance" />

                        <Button onAction="#handleClear" style="-fx-background-color: #777777;                                        -fx-text-fill: white;                                        -fx-font-weight: bold;                                        -fx-padding: 10 30;                                        -fx-background-radius: 5;" text="Clear" />

                    </HBox>

                    <Label fx:id="statusLabel" style="-fx-font-size: 13px;" text="" wrapText="true" />

                </VBox>

                <!-- ATTENDANCE TABLE -->
                <VBox spacing="10" style="-fx-background-color: white;                              -fx-padding: 15;                              -fx-background-radius: 10;                              -fx-border-color: #cbd8ce;                              -fx-border-radius: 10;">

                    <Label style="-fx-font-size: 16px;                                   -fx-font-weight: bold;                                   -fx-text-fill: #123c2a;" text="Cadet Training Attendance Records" />

                    <TableView fx:id="attendanceTable" prefHeight="190">

                        <columns>

                            <TableColumn fx:id="attendanceIdColumn" prefWidth="120" text="Cadet ID" />

                            <TableColumn fx:id="cadetNameColumn" prefWidth="180" text="Cadet Name" />

                            <TableColumn fx:id="companyColumn" prefWidth="130" text="Company" />

                            <TableColumn fx:id="platoonColumn" prefWidth="130" text="Platoon" />

                            <TableColumn fx:id="attendanceStatusColumn" prefWidth="160" text="Attendance Status" />

                        </columns>

                    </TableView>

                </VBox>

                <!-- DISCIPLINE TABLE -->
                <VBox spacing="10" style="-fx-background-color: white;                              -fx-padding: 15;                              -fx-background-radius: 10;                              -fx-border-color: #cbd8ce;                              -fx-border-radius: 10;">

                    <Label style="-fx-font-size: 16px;                                   -fx-font-weight: bold;                                   -fx-text-fill: #123c2a;" text="Cadet Discipline Records" />

                    <TableView fx:id="disciplineTable" prefHeight="140">

                        <columns>

                            <TableColumn fx:id="disciplineCadetIdColumn" prefWidth="120" text="Cadet ID" />

                            <TableColumn fx:id="disciplineCadetNameColumn" prefWidth="180" text="Cadet Name" />

                            <TableColumn fx:id="disciplineTypeColumn" prefWidth="180" text="Discipline Type" />

                            <TableColumn fx:id="disciplineDateColumn" prefWidth="150" text="Date" />

                            <TableColumn fx:id="disciplineRemarksColumn" prefWidth="250" text="Remarks" />

                        </columns>

                    </TableView>

                </VBox>

            </VBox>
        </center>

        <!-- FOOTER -->
        <bottom>
            <HBox alignment="CENTER" prefHeight="40" style="-fx-background-color: #123c2a;">

                <Label style="-fx-text-fill: white;                               -fx-font-size: 11px;" text="Bangladesh Military Academy | Cadet Management System" />

            </HBox>
        </bottom>

    </BorderPane>

</AnchorPane>
