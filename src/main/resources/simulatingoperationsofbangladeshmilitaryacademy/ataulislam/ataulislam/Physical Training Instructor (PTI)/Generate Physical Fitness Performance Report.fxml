<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="780" prefWidth="1100" style="-fx-background-color: #f4f7f5;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cse213.simulatingoperationsofbangladeshmilitaryacademy.ataulislam.Cadet.GeneratePhysicalFitnessPerformanceReportController">

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;                            -fx-background: #f4f7f5;">

            <VBox spacing="20" style="-fx-padding: 25;">

                <!-- PAGE TITLE -->
                <VBox spacing="6">

                    <Label style="-fx-font-size: 25px;                                   -fx-font-weight: bold;                                   -fx-text-fill: #123d2b;" text="Fitness Report Management" />

                    <Label style="-fx-font-size: 13px;                                   -fx-text-fill: #65756b;" text="Generate physical fitness performance reports for cadets." />

                </VBox>

                <!-- REPORT FILTER SECTION -->
                <VBox spacing="15" style="-fx-background-color: white;                              -fx-padding: 22;                              -fx-background-radius: 10;                              -fx-border-color: #dce7df;                              -fx-border-radius: 10;">

                    <Label style="-fx-font-size: 16px;                                   -fx-font-weight: bold;                                   -fx-text-fill: #123d2b;" text="REPORT CONFIGURATION" />

                    <GridPane hgap="20" vgap="15">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="50" />
                            <ColumnConstraints percentWidth="50" />
                        </columnConstraints>

                        <!-- REPORT TYPE -->
                        <Label style="-fx-font-weight: bold;" text="Report Type" GridPane.columnIndex="0" GridPane.rowIndex="0" />

                        <ComboBox fx:id="reportTypeComboBox" maxWidth="Infinity" promptText="Select Report Type" GridPane.columnIndex="0" GridPane.rowIndex="1" />

                        <!-- COMPANY -->
                        <Label style="-fx-font-weight: bold;" text="Company" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <ComboBox fx:id="companyComboBox" maxWidth="Infinity" onAction="#handleCompanyChange" promptText="Select Company" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <!-- PLATOON -->
                        <Label style="-fx-font-weight: bold;" text="Platoon" GridPane.columnIndex="0" GridPane.rowIndex="2" />

                        <ComboBox fx:id="platoonComboBox" maxWidth="Infinity" promptText="Select Platoon" GridPane.columnIndex="0" GridPane.rowIndex="3" />

                        <!-- FROM DATE -->
                        <Label style="-fx-font-weight: bold;" text="From Date" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <DatePicker fx:id="fromDatePicker" maxWidth="Infinity" promptText="Select Start Date" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <!-- TO DATE -->
                        <Label style="-fx-font-weight: bold;" text="To Date" GridPane.columnIndex="0" GridPane.rowIndex="4" />

                        <DatePicker fx:id="toDatePicker" maxWidth="Infinity" promptText="Select End Date" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                  <rowConstraints>
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                  </rowConstraints>

                    </GridPane>

                    <Button maxWidth="Infinity" onAction="#handleGenerateReport" style="-fx-background-color: #167346;                                    -fx-text-fill: white;                                    -fx-font-weight: bold;                                    -fx-font-size: 14px;                                    -fx-padding: 12;                                    -fx-background-radius: 6;" text="Generate Report" />

                </VBox>

                <!-- REPORT SUMMARY -->
                <GridPane hgap="15">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                    </columnConstraints>

                    <VBox spacing="8" style="-fx-background-color: white;                                  -fx-padding: 16;                                  -fx-background-radius: 9;                                  -fx-border-color: #dce7df;                                  -fx-border-radius: 9;" GridPane.columnIndex="0">

                        <Label style="-fx-text-fill: #65756b;                                       -fx-font-weight: bold;                                       -fx-font-size: 11px;" text="TOTAL CADETS" />

                        <Label fx:id="totalCadetsLabel" style="-fx-font-size: 25px;                                       -fx-font-weight: bold;                                       -fx-text-fill: #123d2b;" text="0" />
                    </VBox>

                    <VBox spacing="8" style="-fx-background-color: white;                                  -fx-padding: 16;                                  -fx-background-radius: 9;                                  -fx-border-color: #dce7df;                                  -fx-border-radius: 9;" GridPane.columnIndex="1">

                        <Label style="-fx-text-fill: #65756b;                                       -fx-font-weight: bold;                                       -fx-font-size: 11px;" text="AVERAGE SCORE" />

                        <Label fx:id="averageScoreLabel" style="-fx-font-size: 25px;                                       -fx-font-weight: bold;                                       -fx-text-fill: #167346;" text="0" />
                    </VBox>

                    <VBox spacing="8" style="-fx-background-color: white;                                  -fx-padding: 16;                                  -fx-background-radius: 9;                                  -fx-border-color: #dce7df;                                  -fx-border-radius: 9;" GridPane.columnIndex="2">

                        <Label style="-fx-text-fill: #65756b;                                       -fx-font-weight: bold;                                       -fx-font-size: 11px;" text="HIGHEST SCORE" />

                        <Label fx:id="highestScoreLabel" style="-fx-font-size: 25px;                                       -fx-font-weight: bold;                                       -fx-text-fill: #167346;" text="0" />
                    </VBox>

                    <VBox spacing="8" style="-fx-background-color: white;                                  -fx-padding: 16;                                  -fx-background-radius: 9;                                  -fx-border-color: #dce7df;                                  -fx-border-radius: 9;" GridPane.columnIndex="3">

                        <Label style="-fx-text-fill: #65756b;                                       -fx-font-weight: bold;                                       -fx-font-size: 11px;" text="PASS RATE" />

                        <Label fx:id="passRateLabel" style="-fx-font-size: 25px;                                       -fx-font-weight: bold;                                       -fx-text-fill: #167346;" text="0%" />
                    </VBox>
               <rowConstraints>
                  <RowConstraints />
               </rowConstraints>

                </GridPane>

                <!-- PERFORMANCE TABLE -->
                <VBox spacing="15" style="-fx-background-color: white;                              -fx-padding: 20;                              -fx-background-radius: 10;                              -fx-border-color: #dce7df;                              -fx-border-radius: 10;">

                    <Label style="-fx-font-size: 16px;                                   -fx-font-weight: bold;                                   -fx-text-fill: #123d2b;" text="CADET FITNESS PERFORMANCE DETAILS" />

                    <TableView fx:id="performanceTable" prefHeight="300" VBox.vgrow="ALWAYS">

                        <columns>

                            <TableColumn fx:id="serialColumn" prefWidth="55" text="SL" />

                            <TableColumn fx:id="cadetIdColumn" prefWidth="125" text="Cadet ID" />

                            <TableColumn fx:id="cadetNameColumn" prefWidth="190" text="Cadet Name" />

                            <TableColumn fx:id="companyColumn" prefWidth="135" text="Company" />

                            <TableColumn fx:id="platoonColumn" prefWidth="110" text="Platoon" />

                            <TableColumn fx:id="fitnessScoreColumn" prefWidth="120" text="Fitness Score" />

                            <TableColumn fx:id="performanceColumn" prefWidth="145" text="Performance" />

                        </columns>

                        <placeholder>
                            <Label text="Select report information and click Generate Report." />
                        </placeholder>

                    </TableView>

                    <Label style="-fx-text-fill: #65756b;                                   -fx-font-size: 12px;" text="Fitness performance records are displayed according to the selected filters." />

                </VBox>

                <!-- ACTION BUTTONS -->
                <HBox alignment="CENTER_RIGHT" spacing="15">

                    <Button onAction="#handleClear" prefWidth="110" style="-fx-background-color: #737d78;                                    -fx-text-fill: white;                                    -fx-font-weight: bold;                                    -fx-padding: 12;" text="Clear" />

                    <Button onAction="#handleExportReport" prefWidth="190" style="-fx-background-color: #123d2b;                                    -fx-text-fill: white;                                    -fx-font-weight: bold;                                    -fx-padding: 12;" text="Export CSV Report" />

                </HBox>

                <Label fx:id="messageLabel" style="-fx-text-fill: #167346;                               -fx-font-size: 13px;" text="Ready to generate fitness performance report." />

            </VBox>

        </ScrollPane>
    </center>

    <!-- FOOTER -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #123d2b;                      -fx-padding: 12;">

            <Label style="-fx-text-fill: white;                           -fx-font-size: 11px;" text="Bangladesh Military Academy | Cadet Fitness Performance Management System" />

        </HBox>
    </bottom>

</BorderPane>
