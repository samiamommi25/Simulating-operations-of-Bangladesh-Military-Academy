<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #e8eee9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cse213.simulatingoperationsofbangladeshmilitaryacademy.ataulislam.Physical.LoginthesystemController">

    <children>

        <BorderPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

            <!-- Main Login Section -->

            <center>
                <VBox alignment="CENTER" spacing="20" style="-fx-padding: 35;">

                    <VBox alignment="CENTER" maxWidth="430" prefWidth="430" spacing="12" style="-fx-background-color: white;                                  -fx-background-radius: 15;                                  -fx-padding: 35;                                  -fx-effect: dropshadow(gaussian,                                  rgba(0,0,0,0.15), 18, 0, 0, 5);">

                        <!-- Login Logo -->

                        <Label style="-fx-background-color: #174d32;                                       -fx-text-fill: white;                                       -fx-font-size: 30px;                                       -fx-font-weight: bold;                                       -fx-padding: 15 22 15 22;                                       -fx-background-radius: 50;" text="BMA" />

                        <Label style="-fx-font-size: 26px;                                       -fx-font-weight: bold;                                       -fx-text-fill: #173e2c;" text="Welcome Back!" />

                        <Label style="-fx-font-size: 14px;                                       -fx-text-fill: #777777;" text="Physical Training Instructor" />

                        <Separator />

                        <!-- Username Field -->

                        <VBox alignment="CENTER_LEFT" spacing="8">

                            <Label style="-fx-font-size: 14px;                                           -fx-font-weight: bold;                                           -fx-text-fill: #333333;" text="Username" />

                            <TextField fx:id="usernameField" maxWidth="Infinity" prefHeight="45" promptText="Enter your username" style="-fx-background-color: #f5f7f5;                                               -fx-border-color: #d5ded7;                                               -fx-border-radius: 6;                                               -fx-background-radius: 6;                                               -fx-padding: 10;                                               -fx-font-size: 14px;" />

                        </VBox>

                        <!-- Password Field -->

                        <VBox alignment="CENTER_LEFT" spacing="8">

                            <Label style="-fx-font-size: 14px;                                           -fx-font-weight: bold;                                           -fx-text-fill: #333333;" text="Password" />

                            <PasswordField fx:id="passwordField" maxWidth="Infinity" prefHeight="45" promptText="Enter your password" style="-fx-background-color: #f5f7f5;                                                   -fx-border-color: #d5ded7;                                                   -fx-border-radius: 6;                                                   -fx-background-radius: 6;                                                   -fx-padding: 10;                                                   -fx-font-size: 14px;" />

                        </VBox>

                        <!-- Error / Success Message -->

                        <Label fx:id="messageLabel" alignment="CENTER" maxWidth="Infinity" style="-fx-font-size: 13px;" text="" wrapText="true" />

                        <!-- Login Button -->

                        <Button maxWidth="Infinity" onAction="#handleLogin" prefHeight="48" style="-fx-background-color: #174d32;                                        -fx-text-fill: white;                                        -fx-font-size: 16px;                                        -fx-font-weight: bold;                                        -fx-background-radius: 7;                                        -fx-cursor: hand;" text="LOGIN" />

                        <Label style="-fx-text-fill: #888888;                                       -fx-font-size: 11px;" text="Authorized PTI Personnel Only" />

                    </VBox>

                </VBox>
            </center>

            <!-- Footer Section -->

            <bottom>
                <HBox alignment="CENTER" prefHeight="45" style="-fx-background-color: #123c2a;">

                    <Label style="-fx-text-fill: white;                                   -fx-font-size: 11px;" text="© 2026 Bangladesh Military Academy | All Rights Reserved" />

                </HBox>
            </bottom>

        </BorderPane>

    </children>

</AnchorPane>
